# Copy this file to .env.local and fill in the values from your Google Form (Guide 2).
# NEXT_PUBLIC_ values are built into the page, so never put a secret here.

# The long ID in your form's link: docs.google.com/forms/d/e/<THIS PART>/viewform
NEXT_PUBLIC_WAITLIST_FORM_ID=

# The entry numbers from the form's pre-filled link, for example entry.123456789
NEXT_PUBLIC_WAITLIST_EMAIL_ENTRY=
NEXT_PUBLIC_WAITLIST_SOURCE_ENTRY=